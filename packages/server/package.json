{
  "name": "@atlantica/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Scrapes the resort kiosk site and serves the normalised schedule, PWA and ICS feed",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsc && node dist/src/index.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "scrape": "tsc && node dist/src/scripts/scrape-once.js",
    "setup-clerk": "tsc && node dist/src/scripts/setup-clerk.js"
  },
  "dependencies": {
    "@atlantica/shared": "*",
    "@clerk/backend": "^3.13.2",
    "cheerio": "^1.0.0",
    "fastify": "^4.28.1",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.5.3"
  }
}
