# Copy to .env for local development. In production set these with
# `fly secrets set KEY=value` -- never commit real values.

# Generate with: npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# One unguessable token per person, comma-separated. Each becomes an invite
# link: https://<host>/s/<token>
# Generate with: node -e "console.log([0,0].map(()=>require('crypto').randomBytes(24).toString('base64url')).join(','))"
INVITE_TOKENS=

# Separate token for the calendar feed: https://<host>/feed.ics?key=<token>
ICS_TOKEN=

# Signs the session cookie. Any random string of 16+ characters.
COOKIE_SECRET=

# Optional overrides
# RESORT_TZ=Europe/Athens
# LEAD_MINUTES=30
# PORT=8080

# Development only: allows `expo start --web` (a different port) to call this
# server. Leave unset in production -- the native app uses platform fetch,
# which has no same-origin policy, and the PWA is same-origin.
# DEV_ALLOW_ORIGIN=http://127.0.0.1:8100
