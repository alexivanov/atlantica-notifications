# Apple Developer Team ID -- required to sign the widget extension.
# Find it at developer.apple.com -> Membership, or in Xcode's signing tab.
APPLE_TEAM_ID=

# Which backend the app talks to. Defaults to the Fly deployment; point it at a
# LAN IP (not localhost -- a phone cannot reach your Mac's loopback) for local
# development against a dev server.
# EXPO_PUBLIC_API_URL=http://192.168.1.x:8080

# Clerk publishable key (pk_test_... / pk_live_...). Also set it in eas.json
# build profiles -- production builds do not read this file.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
